# Local development — infrastructure only (api/frontend run on the host)

# Postgres: 15432 on the host because BlueDental.HttpApi.Host/appsettings.json and
# BlueDental.DbMigrator/appsettings.json both point at Host=localhost;Port=15432.
POSTGRES_PORT=15432
POSTGRES_DB=BlueDental
POSTGRES_USER=bluedental
POSTGRES_PASSWORD=bluedental

REDIS_PORT=6379
REDIS_PASSWORD=redis

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

INFRA_BIND_ADDRESS=127.0.0.1
