# Build output
bin/
obj/
dist/
build/

# Dependencies
node_modules/

# IDE and editor files
.vs/
.vscode/
*.user
*.suo

# Environment and local settings
.env
.env.*
!.env.example
appsettings.Development.json

# Logs and temporary files
*.log
# Serilog writes runtime request logs here; they carry patient ids.
BlueDental.BE/src/BlueDental.HttpApi.Host/Logs/
BlueDental.BE/src/BlueDental.DbMigrator/Logs/
BlueDental.BE/Logs/
*.tmp
*.cache
Thumbs.db
.DS_Store

# Claude / Playwright production artifacts
reference-private/
.playwright/
.playwright-mcp/
.playwright-profile/
screenshot-*.png
screenshot-*.cjs
extract-full*

# Loose screenshots (comparison artifacts)
*.png
!BlueDental.FE/src/**/*.png
!BlueDental.FE/public/**/*.png
!docs/**/*.png

# Application logs
**/Logs/
**/logs/

# Browser auth
storage-state*.json
auth.json
cookies.json

# Network captures
*.har

# Secrets
.env
.env.*
!.env.example
# Playwright
BlueDental.FE/test-results/
BlueDental.FE/playwright-report/

# Playwright MCP browser artifacts (snapshots, console logs from local testing)
.playwright-mcp/

# Working copy of the Claude Design project, pulled for reference.
.design-ref/

# Skills dropped into the workspace by tooling — not part of the application.
.claude/skills/

# Markdown is kept out of source control from here on. This does NOT untrack the
# documentation CLAUDE.md requires (docs/clone, docs/testing, the rules): git
# ignores .gitignore for files it already tracks, so those keep working.
*.md
!CLAUDE.md
!AGENTS.md
!docs/**/*.md
!.claude/rules/*.md
!.claude/agents/*.md
